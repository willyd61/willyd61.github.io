---
const stats = [
  { label: 'Years', value: '25+' },
  { label: 'Devices', value: '75,000+' },
  { label: 'Availability', value: '99.999%' },
  { label: 'Delivery', value: 'Idea → POC → Prod' }
];
---

<section class="hero-shell">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
  <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>

  <div class="site-shell hero-content">
    <nav class="hero-nav" aria-label="Primary">
      <a href="#top" class="wordmark">William Lipford</a>
      <div class="hero-nav-links">
        <a href="#pillars">Capabilities</a>
        <a href="#projects">Projects</a>
        <a href="#trust">Trust</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>

    <div class="hero-copy" id="top">
      <p class="hero-role">Enterprise NetOps &amp; Observability Architect</p>
      <h1>I turn large, multi-vendor operational networks into observable, automated, reliable platforms.</h1>
      <p class="hero-subcopy">I bridge technical and business audiences, turning deep systems work into clear outcomes leaders can act on.</p>
      <div class="hero-actions">
        <a href="#projects" class="btn-primary">Explore flagship work</a>
        <a href="#contact" class="btn-secondary">Start a conversation</a>
      </div>
    </div>

    <div class="hero-stats" aria-label="Professional scale">
      {stats.map((stat) => (
        <div class="hero-stat">
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>

    <p class="hero-waterline">I raise the waterline — building systems, standards, and teams that operate better after I leave.</p>
  </div>
</section>
