---
const pillars = [
  {
    number: '01',
    title: 'Observe',
    statement: 'Know what the network is doing — and why.',
    detail: 'NMS architecture, SNMP/SNMPv3, traps, polling, MIBs/OIDs, OpenTelemetry, Prometheus, Grafana, Splunk and event management.',
    tags: ['NMS', 'SNMP', 'Telemetry', 'Observability']
  },
  {
    number: '02',
    title: 'Automate',
    statement: 'Turn operational knowledge into repeatable execution.',
    detail: 'Python, Ansible, APIs, F5, Nautobot, GitOps and source-of-truth workflows across complex multi-vendor estates.',
    tags: ['Python', 'Ansible', 'APIs', 'Nautobot']
  },
  {
    number: '03',
    title: 'Operationalize',
    statement: 'Move the design from whiteboard to production.',
    detail: 'POCs, HA/DR, validation, rollback, runbooks, handoff and mentoring — with production operations designed in from day one.',
    tags: ['POC → Prod', 'HA / DR', 'Validation', 'Mentoring']
  }
];
---

<section id="pillars" class="section-band pillars-section">
  <div class="site-shell">
    <div class="section-intro split-intro">
      <div>
        <p class="section-index">Three operating disciplines</p>
        <h2>Observe. Automate. Operationalize.</h2>
      </div>
      <p>Foundational network-management depth meets modern automation and observability. The tools change; the operating model stays disciplined.</p>
    </div>

    <div class="pillar-rail">
      {pillars.map((pillar) => (
        <article class="pillar-item">
          <span class="pillar-number">{pillar.number}</span>
          <h3>{pillar.title}</h3>
          <p class="pillar-statement">{pillar.statement}</p>
          <p class="pillar-detail">{pillar.detail}</p>
          <div class="tag-row">
            {pillar.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </article>
      ))}
    </div>

    <div class="code-architecture">
      <div>
        <p class="section-index">Code-enabled architecture</p>
        <h3>When architecture needs code, I build the missing piece.</h3>
      </div>
      <p>Development is part of the architecture toolkit: integrations, automation, validation, data handling and the glue between platforms.</p>
    </div>
  </div>
</section>
